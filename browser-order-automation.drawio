        <mxCell id="desc1" value="Users access the order automation application through order.sanghwa.people.aws.dev which resolves via Route 53 DNS. Requests are filtered through WAF for security protection before reaching CloudFront." style="text;html=1;resizable=0;points=[];autosize=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="1470" y="49" width="449" height="118" as="geometry" />
        </mxCell>
        <mxCell id="desc2" value="CloudFront serves static React assets from S3 bucket with optimized caching headers and routes WebSocket API calls to the Application Load Balancer for real-time order tracking." style="text;html=1;resizable=0;points=[];autosize=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="1469" y="172" width="450" height="115" as="geometry" />
        </mxCell>
        <mxCell id="desc3" value="Application Load Balancer distributes incoming requests across ARM64-optimized ECS Fargate tasks running in private subnets across two availability zones for high availability." style="text;html=1;resizable=0;points=[];autosize=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="1469" y="290" width="450" height="117" as="geometry" />
        </mxCell>
        <mxCell id="desc4" value="ECS Fargate tasks run containerized Python FastAPI backend with React&amp;nbsp;&lt;div&gt;frontend&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;, providing WebSocket connections for real-time order automation.&amp;nbsp;&lt;/span&gt;&lt;div&gt;Tasks automatically scale based on demand.&lt;/div&gt;&lt;/div&gt;" style="text;html=1;resizable=0;points=[];autosize=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="1469" y="406" width="470" height="60" as="geometry" />
        </mxCell>
