# AWS Configuration
AWS_REGION=us-west-2
BEDROCK_AGENTCORE_ROLE_ARN=arn:aws:iam::YOUR_ACCOUNT_ID:role/BedrockAgentCoreAdmin
BEDROCK_AGENTCORE_STAGE=prod

# Nova Act
NOVA_ACT_API_KEY=46775fb2-8640-408c-8a94-761b2bfd0d80

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/orderdb

# S3 Configuration
RECORDING_BUCKET=order-automation-recordings-us-west-2-YOUR_ACCOUNT_ID
RECORDING_PREFIX=sessions

# Application
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=your-secret-key-change-in-production

# Browser Configuration
MAX_CONCURRENT_SESSIONS=10
BROWSER_TIMEOUT=300
SCREENSHOT_INTERVAL=5

# Order Processing
ORDER_TIMEOUT=600
MAX_RETRIES=3
RETRY_DELAY=30

# Monitoring
THUMBNAIL_WIDTH=320
THUMBNAIL_HEIGHT=240
SESSION_CLEANUP_INTERVAL=3600