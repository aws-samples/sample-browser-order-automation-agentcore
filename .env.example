# Backend Environment Variables

# AWS Configuration
AWS_REGION=us-west-2
AWS_DEFAULT_REGION=us-west-2

# Application Configuration
FLASK_ENV=development
ENVIRONMENT=development
PORT=8000
PYTHONUNBUFFERED=1

# Security - REQUIRED for production
# Generate a strong password for admin access
ADMIN_PASSWORD=your-strong-password-here

# JWT Secret for token signing (OPTIONAL - auto-generated if not set)
# Only set this if you need consistent tokens across app restarts in development
# AWS deployment: Automatically generated by Terraform
# JWT_SECRET=your-jwt-secret-here

# Database Configuration
# Leave empty to use SQLite for local development
# DATABASE_URL=postgresql://user:password@localhost:5432/order_automation

# S3 Configuration (optional for local development)
# S3_APP_DATA_BUCKET=your-bucket-name

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Logging
LOG_LEVEL=INFO
